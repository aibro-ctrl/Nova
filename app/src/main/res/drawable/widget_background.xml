<?xml version="1.0" encoding="utf-8"?>
<!-- Плашка виджета: тёплая кремовая поверхность, мягкое скругление и органические пятна сверху —
     тот же фон, что в приложении, только в масштабе виджета. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFBF6EE" />
            <corners android:radius="28dp" />
            <stroke android:width="0.5dp" android:color="#33C9DDD3" />
        </shape>
    </item>
    <item android:drawable="@drawable/widget_blobs_pill" />
</layer-list>
