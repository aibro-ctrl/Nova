<?xml version="1.0" encoding="utf-8"?>
<!-- Виджеты «Задачи на сегодня» и «Покупки»: заголовок и несколько строк; касание открывает Нова. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/widget_list_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/manrope_semibold"
        android:maxLines="1"
        android:textColor="#FF292D30"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_list_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/manrope_regular"
        android:lineSpacingExtra="4dp"
        android:maxLines="7"
        android:textColor="#FF3F4548"
        android:textSize="14sp" />
</LinearLayout>
