<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Спросить Нова»: касание открывает окно ассистента поверх рабочего стола. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="16dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_orb">

        <!-- Фирменная волна: кадры меняет приложение, пока Нова слушает — как на главном экране. -->
        <ImageView
            android:id="@+id/widget_wave"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@string/widget_label"
            android:src="@drawable/widget_wave_0" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_semibold"
            android:maxLines="1"
            android:text="@string/tile_label"
            android:textColor="#FF292D30"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_medium"
            android:maxLines="1"
            android:text="@string/widget_hint"
            android:textColor="#FF85888A"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
